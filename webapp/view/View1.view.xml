<mvc:View
    controllerName="zfgtrns.controller.View1"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form"
    xmlns="sap.m">

    <Page
        id="idTransferPage"
        title="FG Stock Transfer"
        class="sapUiSizeCompact"
        busy="{local>/busy}"
        busyIndicatorDelay="0">

        <content>
            <VBox
                id="idTransferVBox"
                width="100%"
                fitContainer="true"
                class="sapUiResponsiveContentPadding">

                <MessageStrip
                    id="idFillInTheTransferDetailsChooseABatchThenSelectTheStockItemsToMoveMessageStrip"
                    text="Fill in the transfer details, choose a batch, then select the stock items to move."
                    showIcon="true"
                    showCloseButton="true"
                    class="sapUiSmallMarginBottom" />

                <Panel
                    id="idTransferDetailsPanel"
                    expandable="true"
                    expanded="true"
                    backgroundDesign="Solid"
                    class="sapUiNoContentPadding">

                    <headerToolbar>
                        <OverflowToolbar id="idTransferDetailsOverflowToolbar">
                            <core:Icon
                                id="idTransferDetailsIcon"
                                src="sap-icon://shipping-status"
                                size="1.2rem" />
                            <Title
                                id="idTransferDetailsTitle"
                                text="Transfer Details"
                                level="H2" />
                            <ToolbarSpacer id="idTransferDetailsToolbarSpacer" />
                            <ObjectStatus
                                id="idRequiredFieldsMarkedWithObjectStatus"
                                text="Required fields marked with *"
                                state="Information" />
                        </OverflowToolbar>
                    </headerToolbar>

                    <content>
                        <f:SimpleForm
                            id="idTransferDetailsSimpleForm"
                            editable="true"
                            columnsXL="4"
                            columnsL="4"
                            columnsM="2"
                            labelSpanXL="4"
                            labelSpanM="4"
                            adjustLabelSpan="false"
                            emptySpanXL="0"
                            singleContainerFullSize="false">
                            <f:content>

                                <!-- Column 1: Plant & Sloc -->
                                <core:Title id="idFirstGroupTitle" text="" />
                                <Label id="idPostingDateLabel" text="Posting Date" required="true" />
                              <DatePicker
    id="idPostingDateDatePicker"
    value="{local>/header/postingDate}"
    valueFormat="dd.MM.yyyy"
    displayFormat="dd.MM.yyyy"
    width="100%" />

                                <Label id="idFromPlantLabel" text="From Plant" required="true" />
                                <Input
    id="idFromPlantInput"
    value="{local>/header/fromPlant}"
    placeholder="Enter Plant"
    showValueHelp="true"
    valueHelpRequest=".onFromPlantInputValueHelpRequest"
    showSuggestion="true"
    suggest=".onFromPlantInputSuggest"
    suggestionItems="{/ZI_PLANTVH}">
    <suggestionItems>
    <core:ListItem id="idPlantFromListItem" key="{Plant}" text="{Plant}" additionalText="{PlantName}" />
</suggestionItems>
</Input>

                                <Label id="idToPlantLabel" text="To Plant" required="true" />
                                <Input
    id="idToPlantInput"
    value="{local>/header/toPlant}"
    placeholder="Enter Plant"
    showValueHelp="true"
    valueHelpRequest=".onToPlantInputValueHelpRequest"
    showSuggestion="true"
    suggest=".onToPlantInputSuggest"
    suggestionItems="{/ZI_PLANTVH}">
    <suggestionItems>
    <core:ListItem id="idPlantToListItem" key="{Plant}" text="{Plant}" additionalText="{PlantName}" />
</suggestionItems>
</Input>

                                <Label id="idFromLocationLabel" text="From Location" required="true" />
                                <!-- <Input
                                    id="inputFromSloc"
                                    value="{local>/header/fromSloc}"
                                    showValueHelp="true"
                                    valueHelpRequest=".onFromSlocValueHelp"
                                    placeholder="Select source storage location..." /> -->

                                    <!-- From Location Input -->
<Input
    id="idFromSlocInput"
    value="{local>/header/fromSloc}"
    placeholder="Enter Location"
    showValueHelp="true"
    valueHelpRequest=".onFromSlocInputValueHelpRequest"
    showSuggestion="{= !!${local>/header/fromPlant} }"
    filterSuggests="false"
    suggest=".onFromSlocInputSuggest"
    suggestionItems="{ path: '/ZI_STORAGELOCATION_VH', suspended: true }">
    <suggestionItems>
        <core:ListItem id="idStorageLocationFromListItem" key="{StorageLocation}" text="{StorageLocation}" additionalText="{StorageLocationName}" />
    </suggestionItems>
</Input>

                                <!-- Column 2: Material -->
                                <core:Title id="idSecondGroupTitle" text="" />
                                <Label id="idToLocationLabel" text="To Location" required="true" />
                                <!-- <Input
                                    id="inputToSloc"
                                    value="{local>/header/toSloc}"
                                    showValueHelp="true"
                                    valueHelpRequest=".onToSlocValueHelp"
                                    placeholder="Select destination storage location..." /> -->

                                    <Input
    id="idToSlocInput"
    value="{local>/header/toSloc}"
    placeholder="Enter Location"
    showValueHelp="true"
    valueHelpRequest=".onToSlocInputValueHelpRequest"
    showSuggestion="{= !!${local>/header/toPlant} }"
    filterSuggests="false"
    suggest=".onToSlocInputSuggest"
    suggestionItems="{ path: '/ZI_STORAGELOCATION_VH', suspended: true }">
    <suggestionItems>
        <core:ListItem id="idStorageLocationToListItem" key="{StorageLocation}" text="{StorageLocation}" additionalText="{StorageLocationName}" />
    </suggestionItems>
</Input>

                                <Label id="idStyleLabel" text="Style" required="true" />
                                <!-- <Input
                                    id="inputStyle"
                                    value="{local>/selection/style}"
                                     showValueHelp="true"
                                    valueHelpRequest=".onStyleValueHelp"
                                    placeholder="Select style..." /> -->

                                    <!-- Style Input -->
<Input
    id="idStyleInput"
    value="{local>/selection/style}"
    placeholder="Enter Style"
    showValueHelp="true"
    valueHelpRequest=".onStyleInputValueHelpRequest"
    showSuggestion="{= !!${local>/header/fromPlant} }"
    filterSuggests="false"
    suggest=".onStyleInputSuggest"
    suggestionItemSelected=".onStyleInputSuggestionItemSelected"
    suggestionItems="{
        path: '/ZI_FG_STYLE',
        suspended: true,
        parameters: { $select: 'StyleName,StyleDesc,BrandName,ProductType,Season,subcat' }
    }">
    <suggestionItems>
        <core:ListItem id="idStyleNameListItem"
            key="{StyleName}" 
            text="{StyleName}" 
            additionalText="{StyleDesc}" />
    </suggestionItems>
</Input>

                                <Label id="idBrandLabel" text="Brand" />
                                <Input
                                    id="idBrandInput"
                                    value="{local>/selection/brand}"
                                    editable="false" />

                                <Label id="idCategoryLabel" text="Category" />
                                <Input
                                    id="idCategoryInput"
                                    value="{local>/selection/category}"
                                    editable="false" />

                                <!-- Column 3: Categories & Batch Mode -->
                                <core:Title id="idThirdGroupTitle" text="" />
                                <Label id="idSeasonLabel" text="Season" />
                                <Input
                                    id="idSeasonInput"
                                    value="{local>/selection/season}"
                                    editable="false" />

                                <Label id="idSubCategoryLabel" text="Sub Category" />
                                <Input
                                    id="idSubCategoryInput"
                                    value="{local>/selection/subCategory}"
                                    editable="false" />

                                <Label id="idSelectionModeLabel" text="Selection Mode" />
                                <SegmentedButton
                                    id="idSelectionModeSegmentedButton"
                                    selectedKey="{local>/header/selectionMode}"
                                    selectionChange=".onSegmentedButtonSelectionChange"
                                    width="100%">
                                    <items>
                                        <SegmentedButtonItem id="idManualSegmentedButtonItem" key="MANUAL" text="Manual" icon="sap-icon://edit" />
                                        <SegmentedButtonItem id="idScanningSegmentedButtonItem" key="SCANNING" text="Scanning" icon="sap-icon://bar-code" />
                                    </items>
                                </SegmentedButton>

                                <Label
                                    id="idBatchSelectionLabel"
                                    text="Batch Selection"
                                    required="true"
                                    visible="{= ${local>/header/selectionMode} === 'MANUAL' }" />
                                <Input
                                    id="idManualBatchInput"
                                    value="{local>/selection/manualBatch}"
                                    placeholder="Select or enter Batch No..."
                                    showValueHelp="true"
                                    valueHelpRequest=".onManualBatchInputValueHelpRequest"
                                    submit=".onManualBatchInputSubmit"
                                    visible="{= ${local>/header/selectionMode} === 'MANUAL' }"
                                    width="100%" />

                                <Label
                                    id="idScanBatchLabel"
                                    text="Scan Batch"
                                    required="true"
                                    visible="{= ${local>/header/selectionMode} === 'SCANNING' }" />
                                <Input
                                    id="idScannedBatchInput"
                                    value="{local>/selection/scannedBatch}"
                                    placeholder="Scan Barcode..."
                                    submit=".onScannedBatchInputSubmit"
                                    visible="{= ${local>/header/selectionMode} === 'SCANNING' }"
                                    width="100%" />

                                <!-- Column 4: Remarks -->
                                <core:Title id="idFourthGroupTitle" text="" />
                                <Label id="idRemarksLabel" text="Remarks" />
                                <TextArea
                                    id="idRemarksTextArea"
                                    value="{local>/header/remarks}"
                                    placeholder="Enter remarks..."
                                    growing="true"
                                    width="100%" />

                            </f:content>
                        </f:SimpleForm>
                    </content>
                </Panel>

                <Panel
                    id="idFromLocationPanel"
                    expandable="true"
                    expanded="true"
                    backgroundDesign="Solid"
                    class="sapUiSmallMarginTop sapUiNoContentPadding">

                    <headerToolbar>
                        <OverflowToolbar id="idFromLocationOverflowToolbar">
                            <core:Icon
                                id="idFromLocationIcon"
                                src="sap-icon://inventory"
                                size="1.2rem" />
                            <Title
                                id="idFromLocationTitle"
                                text="From Location"
                                level="H2" />
                            <ToolbarSpacer id="idFromLocationToolbarSpacer" />
                            <ObjectStatus
                                id="idAvailableStockObjectStatus"
                                text="Available Stock"
                                state="Information" />
                        </OverflowToolbar>
                    </headerToolbar>

                    <content>
                        <Table
                            id="idFromLocationItemsTable"
                            items="{local>/fromLocationItems}"
                            noDataText="No stock items found. Adjust your selection above and try again."
                            sticky="ColumnHeaders,HeaderToolbar"
                            growing="true"
                            mode="MultiSelect"
                            fixedLayout="false"
                            autoPopinMode="true">

                            <headerToolbar>
                                <OverflowToolbar id="idStockItemsOverflowToolbar">
                                    <Title id="idStockItemsLocalfromItemCountTitle" text="Stock Items ({local>/fromItemCount})" level="H3" />
                                    <ToolbarSpacer id="idStockItemsToolbarSpacer" />
                                    <ObjectNumber
                                        id="idFromTotalQtyToolbarObjectNumber"
                                        number="{local>/fromTotalQty}"
                                        unit="Total"
                                        state="Information" />
                                    <ToolbarSeparator id="idStockItemsToolbarSeparator" />
                                    <Button
                                        id="idExportButton"
                                        text="Export"
                                        icon="sap-icon://excel-attachment"
                                        type="Transparent"
                                        press=".onExportButtonPress"
                                        tooltip="Export stock items" />
                                    <Button
                                        id="idDeleteButton"
                                        text="Delete"
                                        icon="sap-icon://delete"
                                        type="Reject"
                                        press=".onDeleteButtonPress"
                                        tooltip="Delete selected items" />
                                </OverflowToolbar>
                            </headerToolbar>

                            <columns>
                                <Column id="idSalesOrderColumn" width="7rem" importance="Low">
                                    <Text id="idSalesOrderText" text="Sales Order" />
                                </Column>
                                <Column id="idSOLineItemColumn" width="6rem" importance="Low">
                                    <Text id="idSOLineItemText" text="SO Line Item" />
                                </Column>
                                <Column id="idStyleColumn" width="7rem" importance="High">
                                    <Text id="idStyleText" text="Style" />
                                </Column>
                                <Column id="idMaterialColumn" width="9rem" importance="High">
                                    <Text id="idMaterialText" text="Material" />
                                </Column>
                                <Column id="idColorColumn" width="6rem" importance="Medium">
                                    <Text id="idColorText" text="Color" />
                                </Column>
                                <Column id="idSizeColumn" width="5rem" importance="Medium">
                                    <Text id="idSizeText" text="Size" />
                                </Column>
                                <Column id="idLotNoColumn" width="6rem" importance="Low">
                                    <Text id="idLotNoText" text="Lot No" />
                                </Column>
                                <Column id="idFromBatchColumn" width="9rem" importance="High">
                                    <Text id="idFromBatchText" text="From Batch" />
                                </Column>
                                <Column id="idToBatchColumn" width="9rem" importance="High">
                                    <Text id="idToBatchText" text="To Batch" />
                                </Column>
                                <Column id="idQuantityColumn" width="7rem" hAlign="End" importance="High">
                                    <Text id="idQuantityText" text="Quantity" />
                                    <footer>
                                        <ObjectNumber id="idFromTotalQtyFooterObjectNumber" number="{local>/fromTotalQty}" state="Success" />
                                    </footer>
                                </Column>
                                <Column id="idUomColumn" width="5rem" importance="High">
                                    <Text id="idUoMText" text="UoM" />
                                </Column>
                            </columns>

                            <items>
                                <ColumnListItem id="idFromLocationColumnListItem" vAlign="Middle">
                                    <cells>
                                        <Text id="idSalesOrderCellText" text="{local>salesOrder}" />
                                        <Text id="idSoLineItemCellText" text="{local>soLineItem}" />
                                        <Text id="idStyleCellText" text="{local>style}" wrapping="false" />
                                        <Text id="idMaterialCellText" text="{local>material}" wrapping="false" />
                                        <Text id="idColorCellText" text="{local>color}" />
                                        <Text id="idSizeCellText" text="{local>size}" />
                                        <Text id="idLotNoCellText" text="{local>lotNo}" />
                                        <ObjectIdentifier id="idFromBatchObjectIdentifier" title="{local>batch}" />
                                        <ObjectIdentifier id="idToBatchObjectIdentifier" title="{local>batch}" />
                                        <Input
                                            id="idQuantityInput"
                                            value="{local>quantity}"
                                            type="Number"
                                            textAlign="End"
                                            change=".onQuantityInputChange" />
                                        <Text id="idUomCellText" text="{local>uom}" />
                                    </cells>
                                </ColumnListItem>
                            </items>

                        </Table>
                    </content>
                </Panel>

            </VBox>
        </content>

        <footer>
            <OverflowToolbar id="idFooterOverflowToolbar">
                <ObjectStatus id="idReadyForTransferObjectStatus"
                    text="{= ${local>/postingSuccessful} ? 'Transfer Posted' : 'Ready for Transfer' }"
                    state="{= ${local>/postingSuccessful} ? 'Success' : 'Information' }" />
                <ToolbarSpacer id="idFooterToolbarSpacer" />
                <Button
                    id="idClearButton"
                    text="Clear"
                    type="Transparent"
                    visible="{= !${local>/postingSuccessful} }"
                    press=".onClearButtonPress"
                    tooltip="Clear the transfer form" />
                <Button
                    id="idSubmitTransferButton"
                    text="Submit Transfer"
                    type="Emphasized"
                    icon="sap-icon://accept"
                    visible="{= !${local>/postingSuccessful} }"
                    press=".onSubmitTransferButtonPress"
                    tooltip="Submit stock transfer" />
                <Button
                    id="idNewButton"
                    text="New"
                    type="Emphasized"
                    visible="{local>/postingSuccessful}"
                    press=".onNewButtonPress"
                    tooltip="Start a new transfer" />
            </OverflowToolbar>
        </footer>

    </Page>

</mvc:View>
